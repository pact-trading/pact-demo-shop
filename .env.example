# Pact API. The hosted testnet is https://api.pactagent.app; a local stack is http://127.0.0.1:3001.
PACT_API_URL=http://127.0.0.1:3001
# Dashboard → Developers → API keys → New key (secret). Stays on this server.
PACT_SECRET_KEY=
# Dashboard → Developers → Webhooks: set the URL to http://localhost:3220/api/webhooks/pact, copy the secret.
PACT_WEBHOOK_SECRET=
# This store's own address, for the return URL after payment.
APP_URL=http://localhost:3220
# Whitechain Sepolia explorer, for transaction links.
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.whitechain.io
